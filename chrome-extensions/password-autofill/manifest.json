{
  "manifest_version": 3,
  "name": "Medtronic Work Assistant",
  "version": "2.11.0",
  "description": "集成自动填充、学习助手、任务管理和EHR一键审批的综合工作助手插件",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Medtronic Smart Assistant",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://api.gpt.medtronic.com/*",
    "https://khplm.medtronic.com.cn/*",
    "https://medtronic.csod.com/*",
    "http://ehr.medtronic.com.cn/*",
    "https://app.powerbi.com/*",
    "https://www.myworkday.com/*",
    "https://medtronic.fabriq.tech/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://khplm.medtronic.com.cn/*"],
      "js": ["page_bridge.js"],
      "run_at": "document_end",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["https://khplm.medtronic.com.cn/*"],
      "js": ["content_windchill_login.js", "content_windchill_assistant.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://medtronic.csod.com/*"],
      "js": ["dev_bridge.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://medtronic.csod.com/*",
        "http://ehr.medtronic.com.cn/*"
      ],
      "js": [
        "mwa_dock.js",
        "content.js",
        "content_ehr_approve.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.powerbi.com/*"
      ],
      "js": [
        "content_pbi.js"
      ]
    },
    {
      "matches": [
        "https://www.myworkday.com/*"
      ],
      "js": [
        "mwa_dock.js",
        "content_workday.js",
        "content_workday_req.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://medtronic.fabriq.tech/*"],
      "js": ["content_fabriq.js", "fabriq_ai_helpers.js", "content_fabriq_ai.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["windchill-icon.svg", "icons/windchill.png"],
      "matches": ["https://khplm.medtronic.com.cn/*"]
    },
    {
      "resources": ["icons/ehr.png"],
      "matches": ["http://ehr.medtronic.com.cn/*"]
    },
    {
      "resources": ["icons/cornerstone.png"],
      "matches": ["https://medtronic.csod.com/*"]
    },
    {
      "resources": ["icons/workday.png"],
      "matches": ["https://www.myworkday.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
